---
import type { Dictionary } from '../../i18n/utils';
import Icon from '../ui/Icon.astro';
import GmailButton from '../ui/GmailButton.astro';
import { socialLinks } from '../../data/social';
import pkg from '../../../package.json';

interface Props {
  t: Dictionary;
}

const { t } = Astro.props;
---

<footer class="section flex items-center justify-between gap-6 flex-wrap py-12 pb-16" data-reveal>
  <div class="flex flex-col gap-1">
    <span class="font-mono fw-bold text-14 tracking-widest text-primary">RC<span class="text-accent">.</span></span>
    <span class="font-mono text-12 text-tertiary" data-i18n="footer_built">{t.footer_built}</span>
    <span class="font-mono text-12 text-tertiary" title="Versión desplegada">v{pkg.version}</span>
  </div>

  <a href="/servicios" class="link-muted" data-i18n="footer_services_cta">{t.footer_services_cta}</a>

  <div class="flex gap-4">
    {socialLinks.map((social) => (
      <a href={social.href} aria-label={social.label} class="icon-link" target="_blank" rel="noopener">
        <Icon name={social.id} size={20} />
      </a>
    ))}
    <GmailButton class="icon-link" iconSize={20} />
  </div>
</footer>

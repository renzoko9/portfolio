---
import type { Dictionary } from "../../i18n/utils";
import SectionEyebrow from "../ui/SectionEyebrow.astro";
import ProjectRow from "../ui/ProjectRow.astro";
import { projects } from "../../data/projects";

interface Props {
  t: Dictionary;
}

const { t } = Astro.props;

const VISIBLE_COUNT = 4;
const visibleProjects = projects.slice(0, VISIBLE_COUNT);
const hiddenProjects = projects.slice(VISIBLE_COUNT);
---

<section id="projects" class="section-frame pt-20" data-reveal>
  <div class="px-edge">
    <SectionEyebrow text={t.proj_eyebrow} i18nKey="proj_eyebrow" />
    <h2 class="font-sans fw-bold text-3xl tracking-tight text-primary mb-8" data-i18n="proj_title">
      {t.proj_title}
    </h2>
  </div>

  <div>
    {visibleProjects.map((project) => <ProjectRow project={project} t={t} />)}

    {
      hiddenProjects.length > 0 && (
        <div id="projects-more" hidden>
          {hiddenProjects.map((project) => <ProjectRow project={project} t={t} />)}
        </div>
      )
    }

    {
      hiddenProjects.length > 0 && (
        <div class="project-toggle-row">
          <button type="button" id="projects-toggle" class="link-muted" data-i18n="proj_show_more">
            {t.proj_show_more}
          </button>
        </div>
      )
    }

    <div class="project-row-spacer" aria-hidden="true" />
  </div>
</section>

<script>
  import { es } from "../../i18n/es";
  import { en } from "../../i18n/en";
  import type { Dictionary } from "../../i18n/utils";

  const dictionaries: Record<"es" | "en", Dictionary> = { es, en };

  const toggle = document.getElementById("projects-toggle");
  const more = document.getElementById("projects-more");

  toggle?.addEventListener("click", () => {
    if (!more) return;
    const lang = document.documentElement.lang === "en" ? "en" : "es";
    const dict = dictionaries[lang];
    const isHidden = more.hasAttribute("hidden");

    if (isHidden) {
      more.removeAttribute("hidden");
      toggle.textContent = dict.proj_show_less;
      toggle.dataset.i18n = "proj_show_less";
    } else {
      more.setAttribute("hidden", "");
      toggle.textContent = dict.proj_show_more;
      toggle.dataset.i18n = "proj_show_more";
    }
  });
</script>

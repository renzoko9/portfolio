---
import type { Dictionary } from "../../i18n/utils";
import type { ProjectEntry } from "../../data/projects";
import { projectStatusMeta } from "../../data/projects";
import Tag from "./Tag.astro";
import Badge from "./Badge.astro";
import Icon from "./Icon.astro";

interface Props {
  project: ProjectEntry;
  t: Dictionary;
}

const { project, t } = Astro.props;
---

<a
  href={project.href}
  class="project-row"
  target={project.external ? "_blank" : undefined}
  rel={project.external ? "noopener" : undefined}
>
  <span class="font-mono text-13 text-tertiary">{project.index}</span>
  <div>
    <div class="flex items-center gap-3 flex-wrap">
      <h3 class="font-sans fw-bold text-2xl text-primary">
        {project.title}
      </h3>
      <Badge
        variant={projectStatusMeta[project.status].variant}
        label={t[projectStatusMeta[project.status].labelKey]}
        i18nKey={projectStatusMeta[project.status].labelKey}
      />
    </div>
    <p class="font-sans text-md text-secondary leading-relaxed max-w-lg mt-3 mb-4" data-i18n={project.descKey}>
      {t[project.descKey]}
    </p>
    <div class="flex gap-2 flex-wrap">
      {project.tags.map((tag) => (
        <Tag label={tag} />
      ))}
    </div>
  </div>
  <span class="icon-arrow">
    <Icon name="arrow-up-right" size={20} />
  </span>
</a>

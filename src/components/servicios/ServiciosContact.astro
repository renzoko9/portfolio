---
import SectionEyebrow from '../ui/SectionEyebrow.astro';
import Icon from '../ui/Icon.astro';
import { contactEmailEncoded } from '../../data/social';
import { CTA_URL, CTA_LABEL } from '../../data/servicios';
---

<section id="contacto" class="section py-20" data-reveal>
  <div class="svc-contact-grid">
    <div>
      <SectionEyebrow text="AGENDA TU LLAMADA GRATIS" />
      <h2 class="font-sans fw-bold text-3xl tracking-tight text-primary mb-4 max-w-xs">
        ¿Listo para vender más y trabajar con menos estrés?
      </h2>
      <p class="font-sans text-md text-secondary leading-relaxed max-w-sm mb-8">
        Sin costo, sin compromiso. En 20 minutos vemos si puedo ayudarte.
      </p>
      <a href={CTA_URL} target="_blank" rel="noopener" class="btn-primary no-underline">
        <Icon name="whatsapp" size={16} />
        <span>{CTA_LABEL}</span>
      </a>
      <p class="font-mono text-12 text-tertiary mt-6">
        ¿Prefieres escribirme directamente? Completa el formulario.
      </p>
    </div>

    <form id="svc-contact-form" class="flex flex-col gap-5" data-mail-to={contactEmailEncoded}>
      <div class="grid grid-cols-2 gap-4">
        <div class="form-field">
          <label for="svc-name" class="form-label">Nombre</label>
          <input id="svc-name" name="name" type="text" required class="form-input" />
        </div>
        <div class="form-field">
          <label for="svc-business" class="form-label">Negocio</label>
          <input id="svc-business" name="business" type="text" required class="form-input" />
        </div>
      </div>
      <div class="form-field">
        <label for="svc-contact" class="form-label">WhatsApp o correo</label>
        <input id="svc-contact" name="contact" type="text" required class="form-input" />
      </div>
      <div class="form-field">
        <label for="svc-msg" class="form-label">¿Qué te gustaría mejorar en tu negocio?</label>
        <textarea id="svc-msg" name="message" rows="5" required class="form-textarea"></textarea>
      </div>
      <button type="submit" class="btn-primary self-start">
        <span>Quiero mejorar mi negocio</span>
        <Icon name="arrow-right" size={16} />
      </button>
      <span class="font-mono text-12 text-tertiary">Te respondo en menos de 24 horas.</span>
    </form>
  </div>
</section>

<style>
  .svc-contact-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-10);
  }
  @media (min-width: 860px) {
    .svc-contact-grid {
      grid-template-columns: 0.9fr 1.1fr;
      gap: var(--space-16);
    }
  }
</style>

<script>
  const form = document.getElementById('svc-contact-form') as HTMLFormElement | null;

  form?.addEventListener('submit', (event) => {
    event.preventDefault();

    const mailTo = form.dataset.mailTo;
    const name = (form.elements.namedItem('name') as HTMLInputElement)?.value ?? '';
    const business = (form.elements.namedItem('business') as HTMLInputElement)?.value ?? '';
    const contact = (form.elements.namedItem('contact') as HTMLInputElement)?.value ?? '';
    const message = (form.elements.namedItem('message') as HTMLTextAreaElement)?.value ?? '';

    const subject = `Quiero mejorar mi negocio: ${business}`;
    const body = `Nombre: ${name}\nNegocio: ${business}\nWhatsApp o correo: ${contact}\n\n${message}`;
    const to = mailTo ? atob(mailTo) : '';

    window.location.href = `mailto:${to}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
  });
</script>
